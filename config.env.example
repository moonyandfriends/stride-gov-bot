# Local runs: copy to config.env and fill in. On Railway, set these as service Variables instead.
# Any channel left blank is skipped.

# Comma-separated; tried in order, falls back on failure.
STRIDE_LCD_ENDPOINTS=https://stride-api.polkachu.com
POLL_SECONDS=60
# STATE_FILE=/data/state.json   # set by the Dockerfile; point at a mounted volume

# --- Slack: Incoming Webhook (api.slack.com/apps -> your app -> Incoming Webhooks)
SLACK_WEBHOOK_URL=
# Your Slack member ID (profile -> ... -> Copy member ID), e.g. U01ABCDEF
SLACK_USER_ID=

# --- Discord: channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=
# Your Discord user ID (enable Developer Mode, right-click yourself -> Copy User ID)
DISCORD_USER_ID=

# --- Push option A: ntfy (free, no account). Install the ntfy app, subscribe to the same topic.
# Pick an unguessable topic name - anyone who knows it can read/post.
NTFY_URL=
NTFY_TOKEN=

# --- Push option B: Pushover (pushover.net; one-time app purchase)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# --- AI review (OpenAI). Leave the key blank to turn it off.
# This must be an API key from platform.openai.com; a ChatGPT Plus/Pro subscription doesn't include API access.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# low | medium | high | xhigh | max
OPENAI_REASONING_EFFORT=medium

# Let the reviewer read Stride source (cached under STATE_FILE's folder, ~12MB per release),
# diff releases, read GitHub release notes, and query the chain before deciding. "off" = one-shot review.
AI_TOOLS=on
REVIEW_MAX_TOOL_CALLS=20
REVIEW_TIME_BUDGET_SECONDS=480
# Optional GitHub token (no scopes needed) - raises the GitHub API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=
